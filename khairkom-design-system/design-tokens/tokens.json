{
  "name": "Khairkom Design Tokens",
  "version": "1.0.0",
  "fonts": {
    "family": "Plus Jakarta Sans, Tajawal, system-ui, sans-serif"
  },
  "spacing": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "32px",
    "space-7": "48px",
    "space-8": "64px"
  },
  "radius": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "opacity": {
    "disabled": 0.4,
    "muted": 0.65,
    "glass": 0.15
  },
  "motion": {
    "transition-fast": "150ms cubic-bezier(0.16, 1, 0.3, 1)",
    "transition-normal": "250ms cubic-bezier(0.16, 1, 0.3, 1)",
    "transition-slow": "450ms cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "themes": {
    "emerald": {
      "primary": "hsl(155, 80%, 25%)",
      "accent": "hsl(42, 95%, 43%)",
      "secondary": "hsl(155, 30%, 45%)",
      "background_light": "hsl(40, 20%, 98%)",
      "background_dark": "hsl(160, 12%, 8%)"
    },
    "royal-blue": {
      "primary": "hsl(224, 85%, 46%)",
      "accent": "hsl(192, 95%, 40%)",
      "secondary": "hsl(220, 25%, 45%)",
      "background_light": "hsl(220, 20%, 96%)",
      "background_dark": "hsl(224, 15%, 9%)"
    },
    "purple": {
      "primary": "hsl(270, 80%, 45%)",
      "accent": "hsl(332, 90%, 50%)",
      "secondary": "hsl(270, 25%, 45%)",
      "background_light": "hsl(270, 10%, 98%)",
      "background_dark": "hsl(270, 15%, 8%)"
    },
    "dark-pro": {
      "primary": "hsl(215, 25%, 15%)",
      "accent": "hsl(145, 80%, 35%)",
      "secondary": "hsl(215, 15%, 45%)",
      "background_light": "hsl(210, 15%, 95%)",
      "background_dark": "hsl(215, 15%, 7%)"
    }
  }
}
